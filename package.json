{
  "name": "env-safe-check",
  "version": "1.2.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "env-safe-check": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "test:types": "npm run typecheck",
    "build": "tsup src/index.ts src/cli.ts src/bin.ts --format esm --dts --out-dir dist",
    "snapshot:version": "npm version prerelease --preid snapshot --no-git-tag-version",
    "snapshot:publish": "npm run build && npm publish --tag snapshot",
    "snapshot": "npm run snapshot:version && npm run snapshot:publish",
    "prepare": "npm run build && husky install",
    "cm": "cz",
    "typecheck": "tsc --noEmit",
    "smoke:refresh": "powershell -ExecutionPolicy Bypass -File scripts/refresh-smoke-app.ps1"
  },
  "keywords": [
  "env",
  "environment",
  "environment variables",
  "dotenv",
  "config",
  "configuration",
  "validation",
  "schema validation",
  "runtime validation",
  "typescript",
  "node",
  "nodejs"
 ],
  "engines": {
    "node": ">=20"
  },
  "author": "Pushpak Kurella",
  "license": "ISC",
  "description": "Validate environment variables with schema-based parsing, defaults, and clear runtime errors.",
  "repository": "github:pushkurella/env-safe-check",
  "homepage": "https://github.com/pushkurella/env-safe-check#readme",
  "bugs": {
    "url": "https://github.com/pushkurella/env-safe-check/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pushkurella"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.6.5",
    "commitizen": "^4.3.1",
    "commitlint": "^20.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.6",
    "tsup": "^6.6.0",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}



